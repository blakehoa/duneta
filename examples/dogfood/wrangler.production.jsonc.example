{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "duneta",
  "main": "worker.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "NODE_ENV": "production"
  },
  "secrets": {
    "required": ["AUTH_SECRET", "CSRF_SECRET"]
  },
  // Origin DB credentials are configured on the Hyperdrive config (dashboard / wrangler CLI),
  // not as Worker secrets. Add one entry per database.connections.*.hyperdrive binding.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<your-hyperdrive-config-id>"
    }
    // { "binding": "HYPERDRIVE_ANALYTICS", "id": "<second-hyperdrive-id>" }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "<your-r2-bucket>"
    }
  ]
}
