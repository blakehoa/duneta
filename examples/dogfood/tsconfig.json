{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./app/.react-router/types"],
    "paths": {
      "duneta/views/component/*": ["../../packages/duneta/dist/views/component/*/index"],
      "duneta/views/component": ["../../packages/duneta/dist/views/component/index"],
      "duneta/views/router": ["../../packages/duneta/dist/views/router/index"],
      "duneta/views/providers": ["../../packages/duneta/dist/views/providers/index"],
      "duneta/views/feedback": ["../../packages/duneta/dist/views/feedback/index"],
      "duneta/views/form": ["../../packages/duneta/dist/views/form/index"],
      "duneta/views/image": ["../../packages/duneta/dist/views/image/index"],
      "duneta/views/script": ["../../packages/duneta/dist/views/script/index"],
      "duneta/middleware/page": ["../../packages/duneta/dist/middleware/page/index"],
      "duneta/middleware/http": ["../../packages/duneta/dist/middleware/http/index"],
      "duneta/auth": ["../../packages/duneta/dist/auth/index"],
      "duneta/permission": ["../../packages/duneta/dist/permission/index"],
      "duneta/query": ["../../packages/duneta/dist/query/index"],
      "duneta/query/ssr-server": ["../../packages/duneta/dist/query/ssr-server"],
      "duneta/i18n": ["../../packages/duneta/dist/i18n/index"],
      "duneta/helpers": ["../../packages/duneta/dist/helpers/index"],
      "duneta/core": ["../../packages/duneta/dist/core/index"],
      "duneta/http": ["../../packages/duneta/dist/http/index"],
      "duneta/http/client": ["../../packages/duneta/dist/http/client/index"],
      "duneta/http/cache": ["../../packages/duneta/dist/http/cache/index"],
      "duneta/http/container": ["../../packages/duneta/dist/http/container/index"],
      "duneta/http/cron": ["../../packages/duneta/dist/http/cron/index"],
      "duneta/http/database": ["../../packages/duneta/dist/http/database/index"],
      "duneta/http/logging": ["../../packages/duneta/dist/http/logging/index"],
      "duneta/http/repositories": ["../../packages/duneta/dist/http/repositories/index"],
      "duneta/http/router": ["../../packages/duneta/dist/http/router/index"],
      "duneta/validators": ["../../packages/duneta/dist/validators/index"],
      "duneta/validators/*": ["../../packages/duneta/dist/validators/*/index"],
      "duneta/starter/layouts": ["../../packages/duneta/dist/starter/layouts/index"],
      "duneta/config/client": ["../../packages/duneta/dist/config/client/index"],
      "duneta/config/client/react-router": ["../../packages/duneta/dist/config/client/react-router"],
      "duneta/config/client/load": ["../../packages/duneta/dist/config/client/load"],
      "duneta/config/client/bootstrap": ["../../packages/duneta/dist/config/client/bootstrap"],
      "duneta/config/server": ["../../packages/duneta/dist/config/server/index"],
      "duneta/worker": ["../../packages/duneta/dist/worker/index"],
      "~/*": ["app/*"]
    }
  },
  "include": [
    "worker.ts",
    "routes/**/*.ts",
    "config/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/.router-runtime/**/*",
    "app/.react-router/types/+server-build.d.ts"
  ]
}
