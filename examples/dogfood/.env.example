# Local Worker secrets — Wrangler / Vite inject into process.env.
# Copy to `.env` (gitignored). Never commit `.env`.
#
# Postgres URL: wrangler.jsonc → hyperdrive[].localConnectionString
# Production DB: Hyperdrive config id in wrangler.production.jsonc

AUTH_SECRET=change-me-dev-auth
CSRF_SECRET=change-me-dev-csrf
