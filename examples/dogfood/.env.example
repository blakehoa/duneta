# Local dev only — Wrangler / Vite plugin inject into Worker runtime.
# Copy to `.env` and adjust. Never commit `.env`.
#
# Postgres: set wrangler.jsonc → hyperdrive[].localConnectionString
# (not DATABASE_URL). See Cloudflare Hyperdrive docs.

AUTH_SECRET=change-me-dev-auth
CSRF_SECRET=change-me-dev-csrf
AUTH_BASE_URL=http://localhost:8787
