{
  "name": "duneta",
  "version": "1.0.2",
  "description": "Full-stack React + Hono on Cloudflare Workers — dev, build, and deploy CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "duneta": "./bin/duneta.mjs"
  },
  "files": [
    "bin",
    "vite.mjs",
    "scripts",
    "dist"
  ],
  "scripts": {
    "generate:exports": "node ./scripts/generate-exports.mjs",
    "generate:ui": "node ./scripts/generate-ui-wrappers.mjs",
    "build": "rm -rf dist && node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist && mkdir -p dist/starter/layouts dist/views/theme && cp starter/layouts/duneta-home.css dist/starter/layouts/duneta-home.css && cp views/theme/globals.css dist/views/theme/globals.css",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "verify:publish": "pnpm run build && node ./scripts/generate-exports.mjs && npm pack --dry-run",
    "prepublishOnly": "pnpm run build && node ./scripts/generate-exports.mjs",
    "postpublish": "node ./scripts/generate-exports.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./vite": "./vite.mjs",
