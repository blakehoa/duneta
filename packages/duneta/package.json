{
  "name": "duneta",
  "version": "0.1.0",
  "description": "Full-stack React + Hono on Cloudflare Workers — dev, build, and deploy CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "duneta": "./bin/duneta.mjs"
  },
  "files": [
    "bin",
    "vite.mjs"
  ],
  "scripts": {
    "generate:exports": "node ./scripts/generate-exports.mjs",
    "prepublishOnly": "pnpm --dir ../client run build && pnpm --dir ../server run build && node ./scripts/sync-bundled.mjs --copy && node ./scripts/generate-exports.mjs --publish",
    "postpublish": "node ./scripts/sync-bundled.mjs --clean && node ./scripts/generate-exports.mjs",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./vite": "./vite.mjs"
  },
  "dependencies": {
    "@react-router/dev": "^8.0.1",
    "duneta-client": "workspace:*",
    "duneta-server": "workspace:*",
    "tsx": "^4.19.4",
    "wrangler": "^4.105.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
