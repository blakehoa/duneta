{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./app/.react-router/types"],
    "paths": {
      "duneta/client/ui/*": [
        "./node_modules/duneta/client/dist/components/*/index",
        "./node_modules/duneta-client/dist/components/*/index"
      ],
      "duneta/client/*": [
        "./node_modules/duneta/client/dist/*",
        "./node_modules/duneta/client/*",
        "./node_modules/duneta-client/dist/*",
        "./node_modules/duneta-client/*"
      ],
      "duneta/server/*": [
        "./node_modules/duneta/server/dist/*",
        "./node_modules/duneta-server/dist/*"
      ],
      "~/*": ["app/*"]
    }
  },
  "include": [
    "worker.ts",
    "duneta.client.config.ts",
    "duneta.server.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/.router-runtime/**/*",
    "app/.react-router/types/+server-build.d.ts"
  ]
}
