{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./app/.react-router/types"],
    "paths": {
      "duneta/views/component/*": ["./node_modules/duneta/dist/views/component/*/index"],
      "duneta/views/component": ["./node_modules/duneta/dist/views/component/index"],
      "duneta/views/router": ["./node_modules/duneta/dist/views/router/index"],
      "duneta/views/providers": ["./node_modules/duneta/dist/views/providers/index"],
      "duneta/views/feedback": ["./node_modules/duneta/dist/views/feedback/index"],
      "duneta/views/form": ["./node_modules/duneta/dist/views/form/index"],
      "duneta/views/image": ["./node_modules/duneta/dist/views/image/index"],
      "duneta/views/script": ["./node_modules/duneta/dist/views/script/index"],
      "duneta/middleware/page": ["./node_modules/duneta/dist/middleware/page/index"],
      "duneta/middleware/http": ["./node_modules/duneta/dist/middleware/http/index"],
      "duneta/auth": ["./node_modules/duneta/dist/auth/index"],
      "duneta/permission": ["./node_modules/duneta/dist/permission/index"],
      "duneta/query": ["./node_modules/duneta/dist/query/index"],
      "duneta/query/ssr-server": ["./node_modules/duneta/dist/query/ssr-server"],
      "duneta/i18n": ["./node_modules/duneta/dist/i18n/index"],
      "duneta/helpers": ["./node_modules/duneta/dist/helpers/index"],
      "duneta/core": ["./node_modules/duneta/dist/core/index"],
      "duneta/http": ["./node_modules/duneta/dist/http/index"],
      "duneta/http/client": ["./node_modules/duneta/dist/http/client/index"],
      "duneta/http/cache": ["./node_modules/duneta/dist/http/cache/index"],
      "duneta/http/container": ["./node_modules/duneta/dist/http/container/index"],
      "duneta/http/cron": ["./node_modules/duneta/dist/http/cron/index"],
      "duneta/http/database": ["./node_modules/duneta/dist/http/database/index"],
      "duneta/http/logging": ["./node_modules/duneta/dist/http/logging/index"],
      "duneta/http/repositories": ["./node_modules/duneta/dist/http/repositories/index"],
      "duneta/routes": ["./node_modules/duneta/dist/routes/index"],
      "duneta/validators": ["./node_modules/duneta/dist/validators/index"],
      "duneta/validators/*": ["./node_modules/duneta/dist/validators/*/index"],
      "duneta/starter/layouts": ["./node_modules/duneta/dist/starter/layouts/index"],
      "duneta/config/client": ["./node_modules/duneta/dist/config/client/index"],
      "duneta/config/client/react-router": ["./node_modules/duneta/dist/config/client/react-router"],
      "duneta/config/client/load": ["./node_modules/duneta/dist/config/client/load"],
      "duneta/config/client/bootstrap": ["./node_modules/duneta/dist/config/client/bootstrap"],
      "duneta/config/server": ["./node_modules/duneta/dist/config/server/index"],
      "duneta/worker": ["./node_modules/duneta/dist/worker/index"],
      "~/*": ["app/*"]
    }
  },
  "include": [
    "worker.ts",
    "routes/**/*.ts",
    "config/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/.router-runtime/**/*",
    "app/.react-router/types/+server-build.d.ts"
  ]
}
